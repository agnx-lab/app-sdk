{
  "name": "@agnx-lab/app-sdk",
  "version": "1.0.0",
  "description": "Agnx 工作区 Sub App 通用协议 surface（类型 + activate(host)）；与具体行业 App 无关。",
  "keywords": [
    "agnx",
    "mini-app",
    "sdk",
    "workspace-app"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/agnx-lab/agnx.git",
    "directory": "packages/app-sdk"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sidecar": {
      "types": "./src/sidecar.ts",
      "import": "./src/sidecar.ts",
      "default": "./src/sidecar.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
